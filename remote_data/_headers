/data/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/data/contacts.json
  Cache-Control: public, max-age=300

/data/v2/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/data/v2/chunks/*
  Cache-Control: public, max-age=31536000, immutable

/docs/*
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/support/*
  Cache-Control: public, max-age=300
